# The runtime binds to loopback only.
ARENA_RUNTIME_HOST=127.0.0.1
ARENA_RUNTIME_PORT=4317
ARENA_DATA_DIR=./arena-archivist-data
ARENA_BROWSER_PROFILE=./runtime/chrome-profile

# Live collection stays disabled until the selector contract has been reviewed.
ARENA_LIVE_COLLECTION=false
ARENA_INDEX_URL=
ARENA_SELECTOR_CONTRACT=

# Provider credentials are optional and used only by explicitly allowed offline analysis.
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
OPENROUTER_API_KEY=
