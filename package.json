{
  "name": "arena-archivist",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n runtime,dashboard -c green,cyan \"npm:runtime\" \"npm:dev:dashboard\"",
    "dev:all": "npm run dev",
    "dev:dashboard": "vinext dev",
    "runtime": "tsx apps/runtime/src/server.ts",
    "arena": "tsx apps/runtime/src/cli.ts",
    "demo": "npm run arena -- demo 10",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "test": "npm run test:core && npm run test:vitest",
    "test:core": "tsx --test packages/archive-store/archive-store.test.mjs packages/rate-governor/rate-governor.test.mjs packages/browser-policy/browser-policy.test.mjs packages/gray-swan-adapter/tests/adapter.test.ts packages/browser-worker/tests/browser-worker.test.ts",
    "test:vitest": "vitest run --config packages/exporter/vitest.node.config.ts",
    "typecheck": "tsc --noEmit",
    "secret-scan": "tsx scripts/secret-scan.ts",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "fflate": "0.8.3",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "playwright-core": "1.62.1",
    "react": "19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.8",
    "yaml": "2.9.0",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.2",
    "@cloudflare/workers-types": "5.20260829.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "concurrently": "10.0.5",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.127.1"
  },
  "type": "module"
}
