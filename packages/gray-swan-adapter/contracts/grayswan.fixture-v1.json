        "required": true,
        "candidates": [
          {
            "id": "fixture.index.href",
            "selector": "a[data-aa-record-link]",
            "source": "attribute",
            "attribute": "href"
          }
        ]
      },
      "title": {
        "required": true,
        "candidates": [
          {
            "id": "fixture.index.title",
            "selector": "[data-aa-record-title]",
            "source": "text"
          }
        ]
