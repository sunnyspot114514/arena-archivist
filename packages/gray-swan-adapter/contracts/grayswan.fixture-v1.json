      { "id": "fixture.index.root", "selector": "[data-aa-index]" },
      {
        "id": "candidate.index.list",
        "selector": "[data-testid=previous-records]"
      }
    ],
    "item": [
      { "id": "fixture.index.item", "selector": "[data-aa-index-item]" },
      { "id": "candidate.index.item", "selector": "[data-testid=record-card]" }
    ],
    "hrefPatterns": {
      "chat": "^/arena/archive/chat_[A-Za-z0-9_-]+$",
      "submission": "^/arena/archive/submission_[A-Za-z0-9_-]+$",
      "profile": "^/arena/archive/profile_[A-Za-z0-9_-]+$"
    },
    "fields": {
      "externalId": {
        "required": true,
        "candidates": [
          {
            "id": "fixture.index.id",
            "selector": ":scope",
            "source": "attribute",
            "attribute": "data-record-id"
          }
        ]
      },
      "kind": {
        "required": true,
        "candidates": [
          {
            "id": "fixture.index.kind",
            "selector": ":scope",
            "source": "attribute",
            "attribute": "data-record-kind"
